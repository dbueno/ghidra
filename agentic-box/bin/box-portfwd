#!/opt/box/env/bin/python3
"""Forward 0.0.0.0:LISTEN to 127.0.0.1:TARGET inside the container.

The GUI bridge (agentic-gui/src/guibridge/GuiAgent.java) binds 127.0.0.1 on
purpose, which is right on a laptop and unhelpful here: a published container
port maps to the container's eth0 address, not to its loopback, so `curl` from
the macOS host gets an empty reply. This hop makes the published port work
without loosening the bridge's own bind address -- the only thing that can reach
it is still something already inside this container's network namespace.

    box-portfwd LISTEN_PORT TARGET_PORT

Connections are accepted before the target exists; each one just fails fast
until Ghidra is up, which is what a poll loop wants anyway.
"""

import socket
import sys
import threading


def pump(src, dst):
    try:
        while True:
            data = src.recv(65536)
            if not data:
                break
            dst.sendall(data)
    except OSError:
        pass
    finally:
        for s in (src, dst):
            try:
                s.shutdown(socket.SHUT_RDWR)
            except OSError:
                pass
            s.close()


def serve(listen_port, target_port):
    srv = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
    srv.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
    srv.bind(("0.0.0.0", listen_port))
    srv.listen(64)
    print(f"forwarding 0.0.0.0:{listen_port} -> 127.0.0.1:{target_port}", flush=True)
    while True:
        client, _ = srv.accept()
        try:
            upstream = socket.create_connection(("127.0.0.1", target_port), timeout=5)
        except OSError:
            # Nothing listening yet. Closing is friendlier than hanging: the
            # caller sees a refused connection and retries.
            client.close()
            continue
        upstream.settimeout(None)
        threading.Thread(target=pump, args=(client, upstream), daemon=True).start()
        threading.Thread(target=pump, args=(upstream, client), daemon=True).start()


if __name__ == "__main__":
    if len(sys.argv) != 3:
        sys.exit(__doc__)
    serve(int(sys.argv[1]), int(sys.argv[2]))
